{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug family-tree-service with Nx",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "nx",
        "serve",
        "family-tree-service"
      ],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/family-tree/family-tree-service/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
